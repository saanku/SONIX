VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional custom endpoint. Development uses Vite's built-in /api/musicbrainz.
# Production defaults to your Supabase project's /functions/v1/musicbrainz.
VITE_MUSICBRAINZ_ENDPOINT=
# Public repository URL or maintainer contact email for MusicBrainz identification.
MUSICBRAINZ_CONTACT=
# Optional public Audius API key for increased read limits. Never use a bearer token here.
VITE_AUDIUS_API_KEY=
